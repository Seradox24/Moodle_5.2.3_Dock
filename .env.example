COMPOSE_PROJECT_NAME=lms-moodle

# Docker image namespace (built images: <namespace>/moodle-web, <namespace>/moodle-app).
IMAGE_NAMESPACE=lms

# Public URL (no domain yet: direct access by IP / localhost).
# Local Windows test:
MOODLE_WWWROOT=http://localhost:18080
# When deployed on the local server, use the server IP instead, e.g.:
# MOODLE_WWWROOT=http://192.168.1.50:18080

# Host bind address for the web port.
# 0.0.0.0 -> reachable from other machines on the LAN by server IP.
# A specific LAN IP -> publish only on that host interface (production).
# 127.0.0.1 -> loopback only (use when a host Nginx reverse proxy is added later).
MOODLE_HTTP_BIND=0.0.0.0

# Host port for the web service.
MOODLE_HTTP_PORT=18080

# Moodle release selected for this NEW installation.
MOODLE_GIT_TAG=v5.2.3
MOODLE_GIT_REF=344232c15336c71b80f9aca8359ce0e0a9f3d116

# Base images. Pin digests after validation in the target environment.
PHP_IMAGE=php:8.3-fpm-bookworm
NGINX_IMAGE=nginx:1.28-alpine
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7-alpine

# Database
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MOODLE_DB_PREFIX=mdl_

# Initial Moodle site
MOODLE_SITE_FULLNAME=Plataforma Moodle
MOODLE_SITE_SHORTNAME=Moodle
MOODLE_LANG=es
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
MOODLE_ADMIN_EMAIL=admin@example.com

# Plugins/themes installed through Moodle persist in the moodle-code volume.
MOODLE_PLUGIN_INSTALL=true
# Enable only after configuring SMTP in Moodle site administration.
MOODLE_MAIL_ENABLED=false

# Reverse proxy / TLS
# MOODLE_REVERSEPROXY must stay true because the published host port
# (MOODLE_HTTP_PORT) differs from the internal container port 80; otherwise
# Moodle detects a "wwwroot mismatch" and redirects in a loop.
MOODLE_REVERSEPROXY=true
# MOODLE_SSLPROXY: set to true only when a host Nginx terminates TLS and
# MOODLE_WWWROOT uses https.
MOODLE_SSLPROXY=false
MOODLE_ROUTER_CONFIGURED=true

# Redis is deployed but sessions remain opt-in.
MOODLE_REDIS_SESSIONS=false
MOODLE_REDIS_HOST=redis
MOODLE_REDIS_PORT=6379
MOODLE_REDIS_DATABASE=0
MOODLE_REDIS_PREFIX=moodle_session_

TZ=America/Santiago

# Reserved future platform integration
SSO_ENABLED=false
SSO_ISSUER_URL=
SSO_CLIENT_ID=
INTEGRATION_API_URL=
