# Copiar a .env y completar los valores de esta instalación.
# URL pública definitiva, igual al dominio configurado en el proxy central.
MOODLE_WWWROOT=https://moodle.example.com

# Credencial de PostgreSQL.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Datos iniciales del sitio.
MOODLE_SITE_FULLNAME=Plataforma Moodle
MOODLE_SITE_SHORTNAME=Moodle
MOODLE_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
MOODLE_ADMIN_EMAIL=admin@example.com

# Installation identity; choose once before creating persistent resources.
COMPOSE_PROJECT_NAME=moodle-prod
MOODLE_HTTP_BIND=127.0.0.1
MOODLE_HTTP_PORT=18080
TZ=UTC
MOODLE_ADMIN_USER=admin
MOODLE_LANG=es
