# Plantilla para el servidor con Nginx central. Copiar a .env y completar
# contraseñas y correo antes de instalar. prepare-env genera la variante local.
COMPOSE_PROJECT_NAME=lms-moodle

# Docker image namespace (built images: <namespace>/moodle-web, <namespace>/moodle-app).
IMAGE_NAMESPACE=lms

# URL pública que el Nginx central asignará a Moodle. Reemplazar antes de instalar.
# Moodle la usa para generar enlaces y redirecciones; no es el destino interno.
MOODLE_WWWROOT=https://moodle.example.com

# El Nginx central del host accede al contenedor solo por este puerto local.
MOODLE_HTTP_BIND=127.0.0.1

# Host port for the web service.
MOODLE_HTTP_PORT=18080

# Moodle core, launcher release and digest-pinned images are fixed in
# releases/release.env, not in per-installation environment files.

# Database
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MOODLE_DB_PREFIX=mdl_

# Initial Moodle site
MOODLE_SITE_FULLNAME=Plataforma Moodle
MOODLE_SITE_SHORTNAME=Moodle
MOODLE_LANG=es
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
MOODLE_ADMIN_EMAIL=admin@example.com

# Plugins/themes installed through Moodle persist in the moodle-code volume.
MOODLE_PLUGIN_INSTALL=true
# Outgoing email is configured later in Moodle site administration, not here.

# Reverse proxy / TLS
# MOODLE_REVERSEPROXY must stay true because the published host port
# (MOODLE_HTTP_PORT) differs from the internal container port 80; otherwise
# Moodle detects a "wwwroot mismatch" and redirects in a loop.
MOODLE_REVERSEPROXY=true
# El Nginx central termina HTTPS y pasa las cabeceras al contenedor.
MOODLE_SSLPROXY=true
MOODLE_ROUTER_CONFIGURED=true

# Redis guarda las sesiones de Moodle. Reiniciar Redis cierra las sesiones activas.
MOODLE_REDIS_SESSIONS=true
MOODLE_REDIS_HOST=redis
MOODLE_REDIS_PORT=6379
MOODLE_REDIS_DATABASE=0
MOODLE_REDIS_PREFIX=moodle_session_

# Operational limits. Units: MiB for sizes, seconds for times, processes for FPM.
# MOODLE_MAX_REQUEST_MB must be greater than MOODLE_MAX_UPLOAD_MB.
MOODLE_MAX_UPLOAD_MB=256
MOODLE_MAX_REQUEST_MB=300
MOODLE_MEMORY_LIMIT_MB=512
MOODLE_MAX_EXECUTION_SECONDS=30
MOODLE_FPM_MAX_CHILDREN=5
MOODLE_FASTCGI_READ_TIMEOUT_SECONDS=120

# Future integrations (SSO, external APIs) are not part of this release.
# Do not add SSO_*/INTEGRATION_API_URL here:
# they have no consumer and the preflight warns about them.
