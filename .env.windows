# Windows local test profile. Tracked in Git (test-only credentials).
# Production values are preserved locally at .env.server (never committed).
#
# Names used by this profile (easy cleanup):
#   project  lms-moodle-dev  -> containers/networks/volumes lms-moodle-dev_*
#   images   lmsdev/moodle-web:5.2.3, lmsdev/moodle-app:5.2.3
#   endpoint http://localhost:18080 (127.0.0.1 only)
# Cleanup: .\scripts\windows\clean-test.ps1 (see docs/windows-test.md)

COMPOSE_PROJECT_NAME=lms-moodle-dev
IMAGE_NAMESPACE=lmsdev

# Local URL on this Windows machine.
MOODLE_WWWROOT=http://localhost:18080

# Loopback only: no LAN exposure during tests.
MOODLE_HTTP_BIND=127.0.0.1

# Host port for the web service.
MOODLE_HTTP_PORT=18080

# Moodle release selected for this NEW installation.
MOODLE_GIT_TAG=v5.2.3
MOODLE_GIT_REF=344232c15336c71b80f9aca8359ce0e0a9f3d116

# Base images. Pin digests after validation in the target environment.
PHP_IMAGE=php:8.3-fpm-bookworm
NGINX_IMAGE=nginx:1.28-alpine
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7-alpine

# Database (test credential; production uses a different one).
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=cdad137b442259a71a7b831af1ff06f6dcdff8865742d1ab
MOODLE_DB_PREFIX=mdl_

# Test site identity.
MOODLE_SITE_FULLNAME=Moodle Dev Local
MOODLE_SITE_SHORTNAME=Moodle Dev
MOODLE_LANG=es
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD='Dev1!780db109abca6bb0d430a665cb436f29'
MOODLE_ADMIN_EMAIL=dev@local.lan

# Plugins/themes installed through Moodle persist in the moodle-code volume.
MOODLE_PLUGIN_INSTALL=true
MOODLE_MAIL_ENABLED=false

# Reverse proxy / TLS
MOODLE_REVERSEPROXY=true
MOODLE_SSLPROXY=false
MOODLE_ROUTER_CONFIGURED=true

# Redis is deployed but sessions remain opt-in.
MOODLE_REDIS_SESSIONS=false
MOODLE_REDIS_HOST=redis
MOODLE_REDIS_PORT=6379
MOODLE_REDIS_DATABASE=0
MOODLE_REDIS_PREFIX=moodle_session_

TZ=America/Santiago

# Reserved future platform integration
SSO_ENABLED=false
SSO_ISSUER_URL=
SSO_CLIENT_ID=
INTEGRATION_API_URL=
