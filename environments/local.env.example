COMPOSE_PROJECT_NAME=lms-moodle-dev
IMAGE_NAMESPACE=lmsdev

# Local Windows/Linux test profile; binds Moodle to this machine only.
# Two simultaneous installations must use different COMPOSE_PROJECT_NAME and
# MOODLE_HTTP_PORT values.
MOODLE_WWWROOT=http://localhost:18080
MOODLE_HTTP_BIND=127.0.0.1
MOODLE_HTTP_PORT=18080

# Moodle core, launcher release and digest-pinned images are fixed in
# releases/release.env, not in per-installation environment files.

# Local database. The preparation script replaces this marker with a new secret.
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
MOODLE_DB_PREFIX=mdl_

# Initial Moodle site.
MOODLE_SITE_FULLNAME=Plataforma Moodle local
MOODLE_SITE_SHORTNAME=Moodle local
MOODLE_LANG=es
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ADMIN_PASSWORD
MOODLE_ADMIN_EMAIL=admin@example.com

MOODLE_PLUGIN_INSTALL=true
# Outgoing email is configured later in Moodle site administration, not here.

# Reverse proxy / TLS.
MOODLE_REVERSEPROXY=true
MOODLE_SSLPROXY=false
MOODLE_ROUTER_CONFIGURED=true

# Redis is deployed but local Moodle sessions remain on the default handler.
MOODLE_REDIS_SESSIONS=false
MOODLE_REDIS_HOST=redis
MOODLE_REDIS_PORT=6379
MOODLE_REDIS_DATABASE=0
MOODLE_REDIS_PREFIX=moodle_session_

# Operational limits. Units: MiB for sizes, seconds for times, processes for FPM.
# MOODLE_MAX_REQUEST_MB must be greater than MOODLE_MAX_UPLOAD_MB.
MOODLE_MAX_UPLOAD_MB=256
MOODLE_MAX_REQUEST_MB=300
MOODLE_MEMORY_LIMIT_MB=512
MOODLE_MAX_EXECUTION_SECONDS=30
MOODLE_FPM_MAX_CHILDREN=5
MOODLE_FASTCGI_READ_TIMEOUT_SECONDS=120

# Future integrations (SSO, external APIs) are not part of this release.
